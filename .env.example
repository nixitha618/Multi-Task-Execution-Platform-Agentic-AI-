# API Configuration
PROJECT_NAME="Agentic AI System for Autonomous Multi-Task Execution"
API_V1_STR="/api/v1"
DEBUG=True

# LLM Configuration
# Set your Groq API Key (get free at https://console.groq.com)
GROQ_API_KEY=""
DEFAULT_MODEL="llama-3.3-70b-versatile"
FAST_MODEL="llama-3.1-8b-instant"

# Offline / Mock LLM Mode (useful for automated testing without API keys)
MOCK_LLM=False

# Storage & Paths
DATABASE_URL="sqlite+aiosqlite:///./data/agentic_ai.db"
CHROMA_PERSIST_DIR="./data/chroma_db"
UPLOAD_DIR="./data/uploads"
OUTPUT_DIR="./data/outputs"

# Embeddings
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"

# Email / Notification Mock or SMTP
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL="agentic-ai@system.local"
EMAIL_MOCK_MODE=True


